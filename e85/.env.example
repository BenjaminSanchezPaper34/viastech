# Copier en .env.local pour travailler en local. Sans ces clés, tout tourne en mode simulé :
# agenda dans .data/mock-calendar.json, demandes dans .data/requests.json, e-mails dans la console.
# En production (Vercel), toutes les variables marquées OBLIGATOIRE doivent être renseignées.

# Adresse publique du site, sans / final (liens des e-mails, .ics, sitemap). OBLIGATOIRE
APP_URL=https://e85.viastech.fr

# Secret de signature des liens d'annulation et de la session admin. OBLIGATOIRE
# Générer : openssl rand -base64 32
APP_SECRET=

# Mot de passe de /e85/admin. OBLIGATOIRE (en local, « viastech » si vide)
ADMIN_PASSWORD=

# --- Google Agenda (compte de service) --- OBLIGATOIRE
GOOGLE_SERVICE_ACCOUNT_EMAIL=viastech-e85@mon-projet.iam.gserviceaccount.com
# Clé privée du fichier JSON, sur une ligne, avec les \n tels quels, entre guillemets
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Paramètres de l'agenda > Intégrer l'agenda > ID de l'agenda
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com

# --- Base de données (Neon, ajoutée depuis le Marketplace Vercel) --- OBLIGATOIRE
DATABASE_URL=

# --- E-mails (Resend) --- OBLIGATOIRE
RESEND_API_KEY=
EMAIL_FROM="Garage Viastech <rdv@viastech.fr>"
# Qui reçoit les notifications de réservation et d'annulation
EMAIL_GARAGE=contact@viastech.fr

# Protège /api/cron/reminders (Vercel l'envoie automatiquement aux crons). OBLIGATOIRE
CRON_SECRET=

# Pixel Meta : laisser vide = désactivé (aucun bandeau, aucun script Facebook)
NEXT_PUBLIC_META_PIXEL_ID=
